import numpy as np
import matplotlib.pyplot as plt
from scipy.cluster.vq import kmeans2
from pyproj import CRS, Transformer
import math

class GranularBall:
    """
    Represents a fuzzy granular ball in projected (X, Y) coordinate space.
    """
    def __init__(self, center, sigma):
        self.center = tuple(center)  # (x, y)
        self.sigma = float(sigma)    # Gaussian spread in projected units (meters)

    def membership(self, coord):
        """
        Compute Gaussian membership of a point based on Euclidean distance.
        """
        dx = coord[0] - self.center[0]
        dy = coord[1] - self.center[1]
        dist = np.hypot(dx, dy)
        return math.exp(-(dist ** 2) / (2 * self.sigma ** 2)) if self.sigma > 0 else 1.0

def generate_fuzzy_granular_balls(points, n_clusters, sigma=None):
    """
    Cluster projected (X, Y) coordinates and return fuzzy granular balls.
    """
    data = np.array(points, dtype=float)
    centroids, labels = kmeans2(data, n_clusters, minit='++')

    balls = []
    for i, center in enumerate(centroids):
        cluster_points = data[labels == i]
        if len(cluster_points) == 0:
            continue
        if sigma is not None:
            sigma_i = sigma
        else:
            dists = np.linalg.norm(cluster_points - center, axis=1)
            sigma_i = np.std(dists)
            sigma_i = max(sigma_i, 1e-6)
        balls.append(GranularBall(center, sigma_i))
    return balls

def fuzzy_overlap(ballA, ballB, resolution=100):
    """
    Compute fuzzy overlap (Jaccard index) between two balls.
    """
    xA, yA = ballA.center
    xB, yB = ballB.center
    max_sigma = max(ballA.sigma, ballB.sigma)
    padding = 3 * max_sigma

    x_min = min(xA, xB) - padding
    x_max = max(xA, xB) + padding
    y_min = min(yA, yB) - padding
    y_max = max(yA, yB) + padding

    x_vals = np.linspace(x_min, x_max, resolution)
    y_vals = np.linspace(y_min, y_max, resolution)
    xx, yy = np.meshgrid(x_vals, y_vals)

    intersection = 0.0
    union = 0.0
    cell_area = ((x_max - x_min) / resolution) * ((y_max - y_min) / resolution)

    for i in range(resolution):
        for j in range(resolution):
            coord = (xx[i, j], yy[i, j])
            μA = ballA.membership(coord)
            μB = ballB.membership(coord)
            intersection += min(μA, μB) * cell_area
            union += max(μA, μB) * cell_area

    return (intersection / union) if union > 0 else 0.0

def qualitative_direction(a, b):
    """
    Return 8-direction compass direction from point a to point b in projected space.
    """
    dx = b[0] - a[0]
    dy = b[1] - a[1]
    if dx == 0 and dy == 0:
        return None
    angle = (math.degrees(math.atan2(dy, dx)) + 360) % 360
    directions = ['E', 'NE', 'N', 'NW', 'W', 'SW', 'S', 'SE']
    index = int(((angle + 22.5) % 360) / 45)
    return directions[index]

def visualize_fuzzy_balls(ballA, ballB, resolution=200):
    """
    Visualize fuzzy membership contours and intersection in 2D projected space.
    """
    xA, yA = ballA.center
    xB, yB = ballB.center
    max_sigma = max(ballA.sigma, ballB.sigma)
    pad = 3 * max_sigma

    x_min = min(xA, xB) - pad
    x_max = max(xA, xB) + pad
    y_min = min(yA, yB) - pad
    y_max = max(yA, yB) + pad

    x_vals = np.linspace(x_min, x_max, resolution)
    y_vals = np.linspace(y_min, y_max, resolution)
    xx, yy = np.meshgrid(x_vals, y_vals)

    membershipA = np.zeros_like(xx)
    membershipB = np.zeros_like(xx)
    intersection = np.zeros_like(xx)

    for i in range(resolution):
        for j in range(resolution):
            pt = (xx[i, j], yy[i, j])
            μA = ballA.membership(pt)
            μB = ballB.membership(pt)
            membershipA[i, j] = μA
            membershipB[i, j] = μB
            intersection[i, j] = min(μA, μB)

    plt.figure(figsize=(10, 8))
    plt.contourf(xx, yy, membershipA, levels=50, cmap='Blues', alpha=0.4)
    plt.contourf(xx, yy, membershipB, levels=50, cmap='Reds', alpha=0.4)
    plt.contourf(xx, yy, intersection, levels=50, cmap='Greens', alpha=0.6)
    plt.scatter([xA], [yA], color='blue', label='Ball A Center')
    plt.scatter([xB], [yB], color='red', label='Ball B Center')
    plt.xlabel("X (meters)")
    plt.ylabel("Y (meters)")
    plt.title("Fuzzy Granular-Balls in Projected Coordinate System")
    plt.legend()
    plt.axis("equal")
    plt.grid(True)
    plt.show()

# Example usage
if __name__ == "__main__":
    # Define input in EPSG:4326 (lat/lon) and project to EPSG:5179 (Korean Transverse Mercator)
    crs_from = CRS("EPSG:4326")      # WGS84 lat/lon
    crs_to = CRS("EPSG:5179")        # Korea EPSG
    transformer = Transformer.from_crs(crs_from, crs_to, always_xy=True)

    # Example input: WGS84 coordinates
    input_coords = [
        (126.9780, 37.5665),  # Seoul City Hall
        (126.9895, 37.5651),  # Near Myeongdong
        (126.9820, 37.5700)   # Near Gwanghwamun
    ]

    # Convert to projected coordinates (X, Y in meters)
    projected_points = [transformer.transform(lon, lat) for lon, lat in input_coords]

    # Generate fuzzy balls in projected space
    balls = generate_fuzzy_granular_balls(projected_points, n_clusters=2, sigma=500)

    # Print membership of test point
    test_proj = transformer.transform(126.9810, 37.5675)
    for i, ball in enumerate(balls):
        μ = ball.membership(test_proj)
        print(f"Ball {i} membership of test point: {μ:.4f}")

    # Compute overlap and direction
    if len(balls) >= 2:
        overlap = fuzzy_overlap(balls[0], balls[1])
        print(f"Fuzzy overlap between Ball 0 and Ball 1: {overlap:.4f}")

        dir_str = qualitative_direction(balls[0].center, balls[1].center)
        print(f"Ball 1 is '{dir_str}' of Ball 0")

        # Visualize
        visualize_fuzzy_balls(balls[0], balls[1])

