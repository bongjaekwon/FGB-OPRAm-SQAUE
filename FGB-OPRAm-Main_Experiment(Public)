import numpy as np
import matplotlib.pyplot as plt
from sklearn.metrics import (
    precision_score, recall_score, f1_score,
    roc_auc_score, average_precision_score
)
from scipy.stats import gaussian_kde, ttest_rel
from tqdm import tqdm
import warnings
warnings.filterwarnings("ignore")

# -----------------------------
# Exp
# -----------------------------
DOMAIN = (-100, 100)
RADIUS = 50
BANDWIDTH = 10
SEED_BASE = 26
NUM_POINTS = 1000
MC_REPEAT = 20
NOISE_LEVELS = [10, 20, 30, 40, 50]
GRID_RES = 100

# -----------------------------
# Cls/Func
# -----------------------------

class FGB_OPRAm:
    def __init__(self, center, sigma, alpha):
        self.center = np.array(center)
        self.sigma = float(sigma)
        self.alpha = float(alpha)

    def membership(self, point, kde_density):
        dist = np.linalg.norm(np.array(point) - self.center)
        dist_score = np.exp(-dist**2 / (2 * self.sigma**2))
        return self.alpha * dist_score + (1 - self.alpha) * kde_density

def crisp_query(points, center, radius):
    return np.linalg.norm(points - center, axis=1) <= radius

def compute_kde_densities(data, bandwidth):
    kde = gaussian_kde(data.T, bw_method=bandwidth / np.std(data, axis=0).mean())
    densities = kde(data.T)
    return densities / densities.max(), kde  

def kde_local_mass(kde, query_point, radius):
    grid_x = np.linspace(*DOMAIN, GRID_RES)
    grid_y = np.linspace(*DOMAIN, GRID_RES)
    mesh = np.array([[x, y] for x in grid_x for y in grid_y])
    probs = kde(mesh.T)
    mask = np.linalg.norm(mesh - query_point, axis=1) <= radius
    return probs[mask].sum() / probs.sum()

def evaluate_metrics(preds, truths, scores=None):
    precision = precision_score(truths, preds, zero_division=0)
    recall = recall_score(truths, preds, zero_division=0)
    f1 = f1_score(truths, preds, zero_division=0)
    auc = roc_auc_score(truths, scores) if scores is not None else np.nan
    ap = average_precision_score(truths, scores) if scores is not None else np.nan
    return {
        'Precision': precision,
        'Recall': recall,
        'F1': f1,
        'AUC': auc,
        'PR-AUC': ap
    }

def get_fgb_opram_params(noise):
    sigma = max(5, 28 - noise * 0.35)
    alpha = max(0.5, 0.85 - noise * 0.007)
    threshold = max(0.06, 0.12 - noise * 0.0015)
    return sigma, alpha, threshold

def average_metrics(metrics_list):
    keys = metrics_list[0].keys()
    return {k: round(np.mean([m[k] for m in metrics_list]), 4) for k in keys}

# -----------------------------
# Main loop
# -----------------------------

all_results = []
f1_store = {'FGB-OPRAm': [], 'Crisp': [], 'KDE': []}

print(f"\n{'='*30}\nFGB-OPRAm Monte Carlo Experiment\n{'='*30}")

for noise in NOISE_LEVELS:
    opram_metrics_list = []
    crisp_metrics_list = []
    kde_metrics_list = []
    opram_f1s, crisp_f1s, kde_f1s = [], [], []

    print(f"\n--- Noise Level: {noise} ---")
    sigma, alpha, threshold = get_fgb_opram_params(noise)

    for i in tqdm(range(MC_REPEAT), desc=f"Noise {noise}"):
        np.random.seed(SEED_BASE + i)

        # DATA gen
        true_points = np.random.uniform(-50, 50, size=(NUM_POINTS, 2))
        noisy_points = true_points + np.random.normal(0, noise, size=true_points.shape)
        center = np.array([0.0, 0.0])
        ground_truth = crisp_query(true_points, center, RADIUS).astype(int)

        # KDE 
        kde_densities, kde_model = compute_kde_densities(noisy_points, BANDWIDTH)

        # FGB-OPRAm 
        opram = FGB_OPRAm(center=center, sigma=sigma, alpha=alpha)
        memberships = np.array([
            opram.membership(pt, kde_densities[i]) for i, pt in enumerate(noisy_points)
        ])
        opram_preds = memberships > threshold
        m_opram = evaluate_metrics(opram_preds, ground_truth, memberships)
        opram_metrics_list.append(m_opram)
        opram_f1s.append(m_opram['F1'])

        # Crisp 
        crisp_preds = crisp_query(noisy_points, center, RADIUS)
        m_crisp = evaluate_metrics(crisp_preds, ground_truth)
        crisp_metrics_list.append(m_crisp)
        crisp_f1s.append(m_crisp['F1'])

        # KDE Local Mass 
        kde_masses = np.array([
            kde_local_mass(kde_model, pt, RADIUS) for pt in noisy_points
        ])
        kde_threshold = np.percentile(kde_masses, 95) * 0.5
        kde_preds = kde_masses > kde_threshold
        m_kde = evaluate_metrics(kde_preds, ground_truth, kde_masses)
        kde_metrics_list.append(m_kde)
        kde_f1s.append(m_kde['F1'])

    all_results.append({
        'Noise': noise,
        'FGB-OPRAm': average_metrics(opram_metrics_list),
        'Crisp': average_metrics(crisp_metrics_list),
        'KDE': average_metrics(kde_metrics_list)
    })

    f1_store['FGB-OPRAm'].append(opram_f1s)
    f1_store['Crisp'].append(crisp_f1s)
    f1_store['KDE'].append(kde_f1s)

# -----------------------------
# Summary
# -----------------------------

print(f"\n{'='*30}\nSummary of Averaged Results\n{'='*30}")
for res in all_results:
    print(f"Noise Level: {res['Noise']}")
    for method in ['FGB-OPRAm', 'Crisp', 'KDE']:
        metrics = res[method]
        print(f"  [{method}] F1: {metrics['F1']:.4f}, Precision: {metrics['Precision']:.4f}, Recall: {metrics['Recall']:.4f}, AUC: {metrics['AUC']:.4f}, PR-AUC: {metrics['PR-AUC']:.4f}")
    print("-" * 50)

# -----------------------------
# Viz (F1-score vs Noise)
# -----------------------------

plt.figure(figsize=(8, 5))
for method in ['FGB-OPRAm', 'Crisp', 'KDE']:
    means = [np.mean(f1_store[method][i]) for i in range(len(NOISE_LEVELS))]
    stds = [np.std(f1_store[method][i]) for i in range(len(NOISE_LEVELS))]
    plt.plot(NOISE_LEVELS, means, label=method)
    plt.fill_between(NOISE_LEVELS, np.array(means) - np.array(stds), np.array(means) + np.array(stds), alpha=0.2)
plt.xlabel("Noise Level (σ)")
plt.ylabel("F1-score")
plt.title("F1-score vs Noise Level")
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.savefig("f1_score_vs_noise.png", dpi=300)
plt.show()

# -----------------------------
# t-test
# -----------------------------

print(f"\n{'='*30}\nPaired t-test Results (FGB-OPRAm vs Others)\n{'='*30}")
from scipy.stats import ttest_rel
for i, noise in enumerate(NOISE_LEVELS):
    f1_opram = f1_store['FGB-OPRAm'][i]
    for other in ['Crisp', 'KDE']:
        f1_other = f1_store[other][i]
        t_stat, p_value = ttest_rel(f1_opram, f1_other)
        print(f"Noise {noise:2d} | FGB-OPRAm vs {other:5s} | p-value: {p_value:.4f} | {'Significant' if p_value < 0.05 else 'Not Sig.'}")
