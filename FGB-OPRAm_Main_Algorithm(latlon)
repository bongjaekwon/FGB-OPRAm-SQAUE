import math
import sys
import numpy as np
import matplotlib.pyplot as plt
from scipy.cluster.vq import kmeans2
import tkinter as tk
from tkinter.scrolledtext import ScrolledText

# Earth's radius in kilometers
EARTH_RADIUS_KM = 6371.0

class GranularBall:
    """
    Represents a fuzzy granular ball with a Gaussian membership function.
    Each ball is centered at a geographic coordinate (lat, lon) with spread sigma (in km).
    """

    def __init__(self, center, sigma):
        """
        Args:
            center: (latitude, longitude) tuple
            sigma: Standard deviation of the Gaussian in kilometers
        """
        self.center = tuple(center)
        self.sigma = float(sigma)

    def membership(self, coord):
        """
        Compute the Gaussian membership of a coordinate relative to this ball.
        μ = exp(-d^2 / (2 * σ^2)), where d is the Haversine distance.

        Args:
            coord: (latitude, longitude) tuple
        Returns:
            membership value in [0.0, 1.0]
        """
        lat1, lon1 = self.center
        lat2, lon2 = coord

        # Convert degrees to radians
        φ1, φ2 = math.radians(lat1), math.radians(lat2)
        Δφ = φ2 - φ1
        Δλ = math.radians(lon2 - lon1)

        # Haversine distance formula
        a = math.sin(Δφ / 2)**2 + math.cos(φ1) * math.cos(φ2) * math.sin(Δλ / 2)**2
        c = 2 * math.asin(math.sqrt(a))
        d = EARTH_RADIUS_KM * c

        if self.sigma > 0:
            return math.exp(- (d ** 2) / (2 * self.sigma ** 2))
        else:
            return 1.0

def generate_fuzzy_granular_balls(points, n_clusters, sigma=None):
    """
    Cluster the given points using K-means and create fuzzy granular balls.

    Args:
        points: list of (latitude, longitude) tuples
        n_clusters: number of granular balls (clusters) to generate
        sigma: fixed standard deviation for all balls (if None, estimate per cluster)

    Returns:
        List of GranularBall objects.
    """
    data = np.array(points, dtype=float)
    centroids, labels = kmeans2(data, n_clusters, minit='++')

    balls = []
    for i, center in enumerate(centroids):
        cluster_points = data[labels == i]
        if len(cluster_points) == 0:
            continue

        if sigma is not None:
            sigma_i = sigma
        else:
            # Estimate sigma from Haversine distances within the cluster
            dists = []
            for lat, lon in cluster_points:
                φ1, φ2 = math.radians(center[0]), math.radians(lat)
                Δφ = φ2 - φ1
                Δλ = math.radians(lon - center[1])
                a = math.sin(Δφ / 2)**2 + math.cos(φ1) * math.cos(φ2) * math.sin(Δλ / 2)**2
                c = 2 * math.asin(math.sqrt(a))
                dists.append(EARTH_RADIUS_KM * c)
            sigma_i = float(np.std(dists))
            sigma_i = max(sigma_i, 1e-6)  # Prevent sigma from being zero

        balls.append(GranularBall(center, sigma_i))
    return balls

def fuzzy_intersection_and_union(ballA, ballB, resolution=100):
    """
    Compute approximate intersection, union, and self-areas for two fuzzy granular balls
    using a grid-based sampling approach.

    Returns:
        intersection_value: ∑ min(μA, μB) * cell_area
        union_value: ∑ max(μA, μB) * cell_area
        areaA_value: ∑ μA * cell_area
        areaB_value: ∑ μB * cell_area
    """
    latA, lonA = ballA.center
    latB, lonB = ballB.center
    max_sigma = max(ballA.sigma, ballB.sigma)

    # Define a bounding box that covers ±3σ around both centers
    lat_offset = (3 * max_sigma) / 111.0
    lon_offset = (3 * max_sigma) / (111.0 * math.cos(math.radians((latA + latB) / 2.0) or 1.0))

    lat_min = min(latA, latB) - lat_offset
    lat_max = max(latA, latB) + lat_offset
    lon_min = min(lonA, lonB) - lon_offset
    lon_max = max(lonA, lonB) + lon_offset

    lat_vals = np.linspace(lat_min, lat_max, resolution)
    lon_vals = np.linspace(lon_min, lon_max, resolution)

    # Grid cell dimensions in kilometers (approximate)
    dlat = (lat_max - lat_min) / (resolution - 1)
    dlon = (lon_max - lon_min) / (resolution - 1)

    intersection = 0.0
    union = 0.0
    areaA = 0.0
    areaB = 0.0

    for φ in lat_vals:
        lat_rad = math.radians(φ)
        cell_area = (EARTH_RADIUS_KM * math.radians(dlat)) * (EARTH_RADIUS_KM * math.radians(dlon) * math.cos(lat_rad))
        for λ in lon_vals:
            μA = ballA.membership((φ, λ))
            μB = ballB.membership((φ, λ))
            intersection += min(μA, μB) * cell_area
            union += max(μA, μB) * cell_area
            areaA += μA * cell_area
            areaB += μB * cell_area

    return intersection, union, areaA, areaB

def fuzzy_overlap(ballA, ballB, resolution=100):
    """
    Estimate fuzzy overlap between two granular balls and normalize to [0,1].

    Returns:
        overlap_value = intersection / union (or 0 if union is zero).
    """
    intersection, union, _, _ = fuzzy_intersection_and_union(ballA, ballB, resolution)
    return (intersection / union) if union > 0 else 0.0

def compute_fuzzy_rcc8(ballA, ballB, resolution=100, epsilon=1e-6):
    """
    Compute fuzzy RCC-8 memberships between two granular balls.
    RCC-8 relations: DC, EC, PO, TPP, NTPP, EQ, TPPi, NTPPi.

    Returns:
        Dictionary of fuzzy memberships for each RCC-8 relation.
    """
    intersection, union, areaA, areaB = fuzzy_intersection_and_union(ballA, ballB, resolution)

    # Compute fuzzy inclusion: A ⊆ B and B ⊆ A
    inclusionAtoB = intersection / areaA if areaA > 0 else 0.0
    inclusionBtoA = intersection / areaB if areaB > 0 else 0.0

    # EQ (Equal): both inclusions close to 1
    eq_membership = min(inclusionAtoB, inclusionBtoA)

    # TPP (Tangential Proper Part): A ⊂ B but not equal
    tpp_membership = max(inclusionAtoB - eq_membership, 0.0)

    # NTPP (Non-Tangential Proper Part): we approximate as some fraction of TPP
    ntpp_membership = tpp_membership * 0.5

    # TPPi (Inverse of TPP): B ⊂ A but not equal
    tppi_membership = max(inclusionBtoA - eq_membership, 0.0)

    # NTPPi (Inverse of NTPP)
    ntppi_membership = tppi_membership * 0.5

    # PO (Partial Overlap): intersection but no inclusion
    po_membership = max(intersection / union - max(inclusionAtoB, inclusionBtoA), 0.0) if union > 0 else 0.0

    # DC (Disconnected): intersection almost zero
    dc_membership = 1.0 - (intersection / (union + epsilon))

    # EC (Externally Connected): small intersection near boundaries
    ec_membership = max(min(1.0 - intersection / (union + epsilon), min(inclusionAtoB, inclusionBtoA)), 0.0)

    # Clip all memberships to [0,1]
    rcc8 = {
        'DC': min(max(dc_membership, 0.0), 1.0),
        'EC': min(max(ec_membership, 0.0), 1.0),
        'PO': min(max(po_membership, 0.0), 1.0),
        'TPP': min(max(tpp_membership, 0.0), 1.0),
        'NTPP': min(max(ntpp_membership, 0.0), 1.0),
        'TPPi': min(max(tppi_membership, 0.0), 1.0),
        'NTPPi': min(max(ntppi_membership, 0.0), 1.0),
        'EQ': min(max(eq_membership, 0.0), 1.0)
    }

    return rcc8

def qualitative_bearing(pointA, pointB):
    """
    Compute the bearing (in degrees) from pointA to pointB.
    0° corresponds to North, increases clockwise.
    """
    lat1, lon1 = pointA
    lat2, lon2 = pointB

    if lat1 == lat2 and lon1 == lon2:
        return None  # Same point

    φ1, φ2 = math.radians(lat1), math.radians(lat2)
    Δλ = math.radians(lon2 - lon1)

    y = math.sin(Δλ) * math.cos(φ2)
    x = math.cos(φ1) * math.sin(φ2) - math.sin(φ1) * math.cos(φ2) * math.cos(Δλ)
    θ = math.atan2(y, x)
    bearing = (math.degrees(θ) + 360) % 360

    return bearing

def opram_direction(pointA, pointB, m):
    """
    Compute the OPRAm direction relation between two points with granularity m.
    360° is divided into 4m evenly sized sectors. Return label "r{i}" where
    i ∈ {0, 1, ..., 4m−1}.

    Args:
        pointA: (lat, lon) reference point
        pointB: (lat, lon) target point
        m: granularity parameter (e.g., m=1 yields 4 directions, m=2 yields 8, etc.)

    Returns:
        relation_label: string "r{i}", or None if points coincide.
    """
    bearing = qualitative_bearing(pointA, pointB)
    if bearing is None:
        return None

    num_sectors = 4 * m
    interval = 360.0 / num_sectors
    # Add half an interval before flooring to center each sector
    index = int(((bearing + (interval / 2.0)) % 360) // interval)
    return f"r{index}"

def opram_converse(relation_label, m):
    """
    Compute the converse (inverse) of an OPRAm relation.
    converse(r_i) = r_{(i + 2m) mod (4m)}

    Args:
        relation_label: string "r{i}"
        m: granularity parameter

    Returns:
        converse_label: string "r{j}", or None if input invalid.
    """
    if relation_label is None:
        return None
    try:
        idx = int(relation_label[1:])
    except (ValueError, IndexError):
        return None

    num_sectors = 4 * m
    j = (idx + 2 * m) % num_sectors
    return f"r{j}"

def opram_composition(rel1, rel2, m):
    """
    Compute a simplified composition of two OPRAm relations.
    A full implementation would use a precomputed composition table;
    here we approximate by (i + j) mod 4m.

    Args:
        rel1: "r{i}"
        rel2: "r{j}"
        m: granularity parameter

    Returns:
        composed_rel: "r{k}" or None if invalid.
    """
    if rel1 is None or rel2 is None:
        return None
    try:
        i = int(rel1[1:])
        j = int(rel2[1:])
    except (ValueError, IndexError):
        return None

    num_sectors = 4 * m
    k = (i + j) % num_sectors
    return f"r{k}"

class SpatialQueryEngine:
    """
    Provides spatial query answering for multiple fuzzy granular balls,
    integrating OPRAm direction and fuzzy RCC-8 topology.
    """

    def __init__(self, balls, m=2, grid_resolution=100):
        """
        Args:
            balls: list of GranularBall objects
            m: OPRAm granularity (default 2 → 8 directions)
            grid_resolution: resolution for fuzzy RCC-8 and overlap computations
        """
        self.balls = balls
        self.m = m
        self.grid_resolution = grid_resolution

    def get_opram_relation(self, idxA, idxB):
        """
        Compute the OPRAm direction between ball idxA and ball idxB.

        Returns:
            relation_label: "r{i}" or None
        """
        if idxA < 0 or idxA >= len(self.balls) or idxB < 0 or idxB >= len(self.balls):
            return None
        A = self.balls[idxA]
        B = self.balls[idxB]
        return opram_direction(A.center, B.center, self.m)

    def get_rcc8_fuzzy(self, idxA, idxB):
        """
        Compute fuzzy RCC-8 memberships between ball idxA and ball idxB.

        Returns:
            Dictionary of RCC-8 memberships, or None if indices invalid.
        """
        if idxA < 0 or idxA >= len(self.balls) or idxB < 0 or idxB >= len(self.balls):
            return None
        A = self.balls[idxA]
        B = self.balls[idxB]
        return compute_fuzzy_rcc8(A, B, resolution=self.grid_resolution)

    def describe_pair(self, idxA, idxB):
        """
        Generate a combined description (string) of OPRAm direction and
        fuzzy RCC-8 topology for ball idxA versus ball idxB.

        Returns:
            A descriptive string in English.
        """
        if idxA < 0 or idxA >= len(self.balls) or idxB < 0 or idxB >= len(self.balls):
            return "Index out of range."

        A = self.balls[idxA]
        B = self.balls[idxB]

        # Compute OPRAm direction
        dir_relation = opram_direction(A.center, B.center, self.m)
        if dir_relation is None:
            dir_desc = "Points coincide."
        else:
            dir_desc = f"OPRAm-{self.m} direction label: '{dir_relation}'."

        # Compute fuzzy RCC-8
        rcc8 = compute_fuzzy_rcc8(A, B, resolution=self.grid_resolution)
        # Determine which relation has the highest membership
        max_relation, max_value = max(rcc8.items(), key=lambda x: x[1])
        topo_desc = f"Fuzzy RCC-8 top relation: '{max_relation}' with membership = {max_value:.4f}."

        return f"Ball {idxB} relative to Ball {idxA}: {dir_desc} {topo_desc}"

    def query_all_pairs(self):
        """
        Compute and return a list of descriptions for all ball pairs (i→j, i≠j).
        """
        descriptions = []
        n = len(self.balls)
        for i in range(n):
            for j in range(n):
                if i == j:
                    continue
                desc = self.describe_pair(i, j)
                descriptions.append(f"[{i}→{j}] {desc}")
        return descriptions

def visualize_fuzzy_balls(ballA, ballB, resolution=200):
    """
    Visualize two fuzzy granular balls and their intersection in 2D.
    """
    latA, lonA = ballA.center
    latB, lonB = ballB.center
    max_sigma = max(ballA.sigma, ballB.sigma)

    lat_offset = (3 * max_sigma) / 111.0
    lon_offset = (3 * max_sigma) / (111.0 * math.cos(math.radians((latA + latB) / 2.0) or 1.0))

    lat_min = min(latA, latB) - lat_offset
    lat_max = max(latA, latB) + lat_offset
    lon_min = min(lonA, lonB) - lon_offset
    lon_max = max(lonA, lonB) + lon_offset

    lat_vals = np.linspace(lat_min, lat_max, resolution)
    lon_vals = np.linspace(lon_min, lon_max, resolution)
    lon_grid, lat_grid = np.meshgrid(lon_vals, lat_vals)

    membershipA = np.zeros_like(lat_grid)
    membershipB = np.zeros_like(lat_grid)
    intersection = np.zeros_like(lat_grid)

    for i in range(resolution):
        for j in range(resolution):
            coord = (lat_grid[i, j], lon_grid[i, j])
            μA = ballA.membership(coord)
            μB = ballB.membership(coord)
            membershipA[i, j] = μA
            membershipB[i, j] = μB
            intersection[i, j] = min(μA, μB)

    plt.figure(figsize=(10, 8))
    plt.contourf(lon_grid, lat_grid, membershipA, levels=50, cmap='Blues', alpha=0.4)
    plt.contourf(lon_grid, lat_grid, membershipB, levels=50, cmap='Reds', alpha=0.4)
    plt.contourf(lon_grid, lat_grid, intersection, levels=50, cmap='Greens', alpha=0.6)

    plt.scatter([lonA], [latA], c='blue', label='Ball A Center')
    plt.scatter([lonB], [latB], c='red', label='Ball B Center')

    plt.title("Fuzzy Granular-Ball Membership and Intersection")
    plt.xlabel("Longitude")
    plt.ylabel("Latitude")
    plt.legend()
    plt.grid(True)
    plt.show()

