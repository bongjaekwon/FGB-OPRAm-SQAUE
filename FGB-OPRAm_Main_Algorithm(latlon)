class StdoutRedirector:
    """
    A simple redirector that writes all stdout text into a Tkinter Text widget.
    """

    def __init__(self, text_widget):
        self.text_widget = text_widget

    def write(self, string):
        # Insert the string into the text widget and scroll to the end
        self.text_widget.insert(tk.END, string)
        self.text_widget.see(tk.END)

    def flush(self):
        # No-op for compatibility
        pass

def run_spatial_example():
    """
    Example routine that generates granular balls, computes memberships, overlap,
    OPRAm directions, RCC-8 relations, and prints them. All print statements
    will appear in the GUI window because stdout has been redirected.
    """
    # Sample coordinates (latitude, longitude)
    points = [
        (37.5665, 126.9780),  # Seoul City Hall
        (37.5651, 126.9895),  # Gwanghwamun
        (37.5700, 126.9820),  # Jongno area
        (37.5610, 126.9830),  # Near Namsan Tower
        (37.5705, 126.9769)   # Near Bukchon Hanok Village
    ]

    # Generate 2 fuzzy granular balls with fixed sigma = 0.5 km
    balls = generate_fuzzy_granular_balls(points, n_clusters=2, sigma=0.5)

    # Print ball centers and sigma values
    for i, ball in enumerate(balls):
        print(f"Ball {i}: Center = ({ball.center[0]:.4f}, {ball.center[1]:.4f}), σ = {ball.sigma:.4f} km")

    # Test membership of a specific point
    test_point = (37.5675, 126.9810)
    for i, ball in enumerate(balls):
        μ = ball.membership(test_point)
        print(f"Ball {i} membership of test point = {μ:.4f}")

    # Compute fuzzy overlap between Ball 0 and Ball 1
    if len(balls) >= 2:
        overlap_val = fuzzy_overlap(balls[0], balls[1], resolution=200)
        print(f"Fuzzy overlap between Ball 0 and Ball 1 = {overlap_val:.4f}")

        # Compute OPRAm-2 (8-direction) relation from Ball 0 to Ball 1
        direction_01 = opram_direction(balls[0].center, balls[1].center, m=2)
        print(f"OPRAm-2 direction from Ball 0 to Ball 1: '{direction_01}'")

        # Compute fuzzy RCC-8 relations between Ball 0 and Ball 1
        rcc8_01 = compute_fuzzy_rcc8(balls[0], balls[1], resolution=200)
        print("Fuzzy RCC-8 relations between Ball 0 and Ball 1:")
        for rel, val in rcc8_01.items():
            print(f"  {rel}: {val:.4f}")

        # Show OPRAm converse and composition examples
        converse_10 = opram_converse(direction_01, m=2)
        composed_01_10 = opram_composition(direction_01, converse_10, m=2)
        print(f"Converse of '{direction_01}' is '{converse_10}', composition gives '{composed_01_10}'")

        # Launch a plot to visualize the two balls and their intersection
        visualize_fuzzy_balls(balls[0], balls[1], resolution=200)

    # Use the SpatialQueryEngine to output all pairwise relations
    engine = SpatialQueryEngine(balls, m=2, grid_resolution=150)
    all_relations = engine.query_all_pairs()
    print("\nAll pairwise spatial relations:")
    for desc in all_relations:
        print(desc)

def main():
    """
    Create a Tkinter window, redirect stdout to the text widget, and run the example.
    """
    root = tk.Tk()
    root.title("FGB-OPRAm Spatial Reasoning Output")

    # Create a ScrolledText widget for displaying print output
    text_area = ScrolledText(root, wrap=tk.WORD, width=100, height=30)
    text_area.pack(fill=tk.BOTH, expand=True)

    # Redirect stdout and stderr to the text widget
    sys.stdout = StdoutRedirector(text_area)
    sys.stderr = StdoutRedirector(text_area)

    # Run the spatial example after the GUI has started
    root.after(100, run_spatial_example)

    # Start the Tkinter main event loop
    root.mainloop()

if __name__ == "__main__":
    main()
